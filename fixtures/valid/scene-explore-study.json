{
  "id": "study",
  "title": "書房",
  "sceneKind": "explore",
  "bg": { "asset": "bg/study", "trans": "fade", "ms": 400 },
  "hotspots": [
    {
      "id": "desk",
      "name": "書桌",
      "shape": { "type": "rect", "x": 600, "y": 500, "w": 420, "h": 220 },
      "visibleIf": null,
      "enabledIf": null
    },
    {
      "id": "door",
      "name": "門",
      "shape": { "type": "rect", "x": 1400, "y": 180, "w": 280, "h": 720 },
      "defaultVerb": "move"
    },
    {
      "id": "butler",
      "name": "管家",
      "shape": { "type": "rect", "x": 200, "y": 220, "w": 300, "h": 700 }
    },
    {
      "id": "window",
      "name": "窗",
      "shape": {
        "type": "polygon",
        "points": [[100, 80], [400, 80], [400, 300], [100, 260]]
      }
    }
  ],
  "interactions": [
    {
      "hotspot": "desk",
      "on": { "verb": "look" },
      "rules": [
        {
          "when": [{ "switch": "drawer_open", "is": true }],
          "do": [{ "type": "say", "text": "抽屜開咗。" }]
        },
        {
          "when": [],
          "do": [{ "type": "say", "text": "一張舊書桌。" }]
        }
      ]
    },
    {
      "hotspot": "desk",
      "on": { "item": "key" },
      "rules": [
        {
          "when": [],
          "do": [
            { "type": "setSwitch", "id": "drawer_open", "value": true },
            { "type": "say", "text": "鎖匙對上咗。" }
          ]
        }
      ]
    },
    {
      "hotspot": "door",
      "on": { "verb": "move" },
      "rules": [
        {
          "when": [{ "switch": "door_open", "is": true }],
          "do": [{ "type": "gotoScene", "scene": "ending", "trans": "fade_black" }]
        },
        {
          "when": [],
          "do": [{ "type": "say", "text": "鎖住咗。" }]
        }
      ]
    },
    {
      "hotspot": "butler",
      "on": { "verb": "talk" },
      "rules": [
        {
          "when": [],
          "do": [{ "type": "call", "scene": "dlg_butler", "trans": "fade_black" }]
        }
      ]
    }
  ],
  "onEnter": []
}
